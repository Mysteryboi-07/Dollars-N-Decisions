    maxReward: 30
  hard:
    taskCount: 5
    sequenceLength: 6
    taskTimeLimit: 10
    maxReward: 45
  workActionName: Work
  returnHomeAtEndOfOfficeDay: 0
  sleepAfterMidnightHomeWork: 1
